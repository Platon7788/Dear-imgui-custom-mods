(
    viewer: (
        theme: Dark,
        show_labels: HoverOnly,
        min_label_zoom: 0.6,
        show_edge_labels: false,
        edge_arrow: true,
        edge_bundling: false,
        background_grid: true,
        minimap: false,
        selection_mode: Additive,
        lod_threshold: 5000,
        time_travel: None,
        drag_enabled: true,
        context_menu_enabled: true,
        pin_on_drag: true,
        hover_fade_opacity: 0.15,
        glow_on_hover: true,
        text_fade_threshold: 0.0,
        node_size_multiplier: 1.0,
        edge_thickness_multiplier: 1.0,
        edge_curve: 0.0,
        color_groups: [],
        show_orphans: true,
        show_unresolved: true,
        show_tags: true,
        gravity_direction: (0.0, 0.0),
        fit_padding: 40.0,
        depth_fade: false,
        cluster_hulls: false,
        search_highlight_mode: true,
        locale: En,
    ),
    force: (
        barnes_hut_theta: 0.9,
        repulsion: 120.0,
        attraction: 0.04,
        center_pull: 0.002,
        collision_radius: 20.0,
        link_distance: 80.0,
        velocity_decay: 0.6,
        gravity_strength: 0.0,
        radius_by_degree: true,
        radius_base: 4.0,
        radius_per_degree: 1.5,
    ),
)
