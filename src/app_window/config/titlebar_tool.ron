// `TitlebarConfig::tool()` — compact preset for tool / palette windows.
// Smaller height, close-only buttons, no double-click maximize.

(
    height: 22.0,
    title_visible: true,
    title_align: Left,
    title_padding_left: 10.0,
    icon: None,
    separator_visible: true,
    separator_height: 1.0,
    double_click_maximize: false,
    buttons: (
        minimize: false,
        maximize: false,
        close: true,
        width: 44.0,
        icon_radius: 6.0,
        icon_hover_pad: 4.0,
        hover_zoom_scale: 1.20,
        show_hover_bg: false,
    ),
    close_mode: Immediate,
)
