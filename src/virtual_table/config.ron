(
    resizable: true,
    reorderable: false,
    hideable: true,
    sortable: true,
    multi_sort: false,
    borders: Full,
    show_row_lines: true,
    show_column_lines: true,
    row_bg: true,
    scroll_x: false,
    scroll_y: true,
    highlight_hovered: true,
    flat_headers: false,
    show_headers: true,
    context_menu: true,
    freeze_cols: 0,
    freeze_rows: 1,
    sizing: FixedFit,
    selection_mode: Single,
    selection_color: (0.20, 0.45, 0.85, 0.75),
    selection_text_color: Some((1.0, 1.0, 1.0, 1.0)),
    copy_to_clipboard: false,
    edit_trigger: DoubleClick,
    commit_on_focus_loss: true,
    auto_scroll: false,
    row_density: Normal,
    default_row_height: None,
    snap_last_row: false,
    default_clip_tooltip: true,
)
