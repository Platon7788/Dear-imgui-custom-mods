(
    table: (
        resizable: true,
        reorderable: false,
        hideable: true,
        sortable: true,
        multi_sort: false,
        borders: Full,
        show_row_lines: true,
        show_column_lines: true,
        row_bg: true,
        scroll_x: false,
        scroll_y: true,
        highlight_hovered: true,
        flat_headers: true,
        show_headers: true,
        context_menu: true,
        freeze_cols: 0,
        freeze_rows: 1,
        sizing: FixedFit,
        selection_mode: Single,
        selection_color: (0.20, 0.45, 0.85, 0.75),
        selection_text_color: Some((1.0, 1.0, 1.0, 1.0)),
        copy_to_clipboard: false,
        edit_trigger: DoubleClick,
        commit_on_focus_loss: true,
        auto_scroll: false,
        row_density: Dense,
        default_row_height: None,
        snap_last_row: false,
        default_clip_tooltip: true,
        // VirtualTree calls `begin_table` directly, so this nested flag
        // has no effect — keep `false` to signal "no inner card here".
        card_border: false,
    ),
    tree_column: 0,
    indent_width: 20.0,
    show_tree_lines: false,
    tree_line_color: (0.35, 0.35, 0.35, 0.6),
    expand_style: Arrow,
    expand_on_double_click: true,
    auto_expand_on_filter: true,
    lazy_load: false,
    drag_drop_enabled: false,
    striped: true,
    flat_headers: true,
    max_nodes: 10000000,
    evict_on_overflow: false,
    striped_color: (1.0, 1.0, 1.0, 0.02),
    arrow_color: (0.65, 0.68, 0.72, 1.0),
    badge_color: (0.50, 0.55, 0.62, 1.0),
    card_border: true,
)
