// `TitlebarConfig::default()` — main-window chrome layout values.
//
// Schema lives in `config.rs`; this file owns the value side. `Buttons`
// is inlined (ron 0.8 has no `include` mechanism); `Buttons::close_only`
// in `config.rs` reuses these defaults via `..Buttons::default()` and
// flips `minimize` / `maximize` to `false`.

(
    height: 28.0,
    title_visible: true,
    title_align: Left,
    title_padding_left: 10.0,
    icon: None,
    separator_visible: true,
    separator_height: 1.0,
    double_click_maximize: true,
    buttons: (
        minimize: true,
        maximize: true,
        close: true,
        width: 44.0,
        icon_radius: 6.0,
        hover_zoom_scale: 1.20,
    ),
    close_mode: Immediate,
)
